# Alert destination
EMAIL_TO=bharadwajr278@gmail.com,tech@brokket.com

# Gmail SMTP (use a Google App Password, not your normal Google password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=your-sending-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM=your-sending-gmail-address@gmail.com

# The official list is large; 120 seconds balances speed and portal load.
POLL_INTERVAL_SECONDS=120
STATE_DB=data/haryana_rera.sqlite3

# Safe first-run behavior: baseline existing registrations without emailing them.
ALERT_ON_FIRST_RUN=false
DRY_RUN=false
LOG_LEVEL=INFO

# Password-protected admin dashboard at http://localhost:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_PORT=8080

# Hosted admin dashboard ingestion (keep ADMIN_API_KEY secret)
ADMIN_API_URL=https://rera-mail-admin-bharadwaj.bhardwaj0129.chatgpt.site
ADMIN_API_KEY=replace-with-generated-ingest-key
# Required only when the Sites dashboard remains owner-private.
OAI_SITES_AUTH_TOKEN=replace-with-sites-bypass-token
ADMIN_SYNC_BASELINE=true
